<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 権限の全リストと注意点は docs/05_ANDROID_CONSTRAINTS.md 1〜2 章。 -->

    <!-- Notion API への送信（Phase 2.5）。INTERNET は通常権限なので実行時の許可は不要。
         ACCESS_NETWORK_STATE は WorkManager の「ネット接続時のみ実行」制約が使う。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 超過画面（Phase 4）。全画面表示は通知の一種なので通知の許可が土台になる。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- 期限の予約。USE_EXACT_ALARM はインストール時に自動付与される。
         SCHEDULE_EXACT_ALARM は宣言しない（両方宣言もダメ。docs/05 2.1）。 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 超過中のバイブと覆いを動かし続けるサービス。shortService は 3 分で殺されるので使わない。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 他のアプリの上に覆いを出す（Phase 5）。ユーザーが設定画面で許可する必要がある。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 再起動後の期限の予約し直し。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".TaskTimerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.TaskTimer">

        <!-- singleTask：超過画面や覆いから「切り替えフローを開いて」と頼まれたとき、
             常に同じ 1 枚に onNewIntent で届くようにする。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TaskTimer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 超過画面専用（docs/02_ARCHITECTURE.md 4 章）。ロック画面の上に出し、画面を点け、
             最近使ったアプリ一覧には出さない。MainActivity と混ぜると事故るので別 Activity。 -->
        <activity
            android:name=".ui.overdue.OverdueActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.TaskTimer" />

        <!-- 超過している間だけ生きるサービス（バイブ・覆い）。タイマー用の専用タイプは無いので specialUse。 -->
        <service
            android:name=".block.OverdueGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="task_overdue_guard_vibration_and_overlay" />
        </service>

        <receiver
            android:name=".timer.OverdueReceiver"
            android:exported="false" />

        <receiver
            android:name=".timer.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
